# Copy this file to .env and fill in values as needed.
# The platform runs fully offline with a rule-based insight fallback
# when OPENAI_API_KEY is not set.

# OpenAI API key (or key for any OpenAI-compatible endpoint)
OPENAI_API_KEY=sk-your-key-here

# Optional: custom base URL for Azure OpenAI, Ollama, vLLM, etc.
# Examples:
#   https://api.openai.com/v1
#   http://localhost:11434/v1
OPENAI_BASE_URL=

# Optional model override (default from config/settings.yaml)
LLM_MODEL=gpt-4o-mini
